PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=railway_reservation

# Only thing to change for login tokens (they never expire). Use a long random string.
JWT_SECRET=replace_this_with_a_long_random_string

# Live PNR status (used when a PNR is not in your own database).
# RapidAPI: key from your RapidAPI dashboard. HOST must match the API you subscribed to
# (it is shown as X-RapidAPI-Host in RapidAPI's code snippet).
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=irctc1.p.rapidapi.com
RAPIDAPI_PNR_PATH=/api/v3/getPNRStatus
# Optional alternative provider (only used if RAPIDAPI_KEY is empty):
INDIAN_RAIL_API_KEY=

# Anyone with this code can self-register as an admin from the Admin portal.
# Change it, and only share it with people who should have staff access.
ADMIN_SIGNUP_CODE=admin2026

# Used only by utils/seedAdmin.js to create the first admin account
ADMIN_EMAIL=admin@railsarthi.in
ADMIN_PASSWORD=admin123
ADMIN_NAME=Rail Sarthi Admin

# SMS: console (print only) | fast2sms | twilio
SMS_PROVIDER=console
FAST2SMS_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
RAPIDAPI_LIVE_PATH=/api/v1/liveTrainStatus

# Train Status via RailRadar (free plan: 100 requests/month; answers are cached)
RAILRADAR_API_KEY=
RAILRADAR_CACHE_MIN=10
